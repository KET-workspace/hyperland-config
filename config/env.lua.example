-- Port dari env.conf (variabel $...) + $mainMod dari keybindings.conf
-- Sumber kebenaran monitor/program untuk Lua + script/ (bash baca file ini via grep).
-- Salin ke env.lua: cp config/env.lua.example config/env.lua
local env = {
    -- DEFAULT PROGRAMS
    terminal    = "kitty",
    fileManager = "thunar",
    launcher    = "noctalia-shell --launch-app",
    menu        = "rofi",
    browser     = "zen-browser",

    -- THEME
    menuTheme      = os.getenv("HOME") .. "/.config/rofi/launchers/type-1/style-5.rasi",
    cliphistTheme  = os.getenv("HOME") .. "/.config/rofi/launchers/type-1/style-1.rasi",
    powermenuTheme = os.getenv("HOME") .. "/.config/rofi/powermenu/type-1/powermenu.sh",

    -- MONITOR
    mainMonitor      = "eDP-1",
    mainResolution   = "1920x1080@59.96",
    mainPosition     = "auto",
    mainScale        = 1,
    secondMonitor    = "eDP-1",
    secondResolution = "1920x1080@59.96",
    secondPosition   = "auto",
    secondScale      = 1,

    -- BACKGROUND
    srcMainBackground = os.getenv("HOME") .. "/Pictures/asci_art.png",

    -- SCRIPT (autostart.conf / keybindings.conf)
    scrPath = os.getenv("HOME") .. "/.config/hypr/script",

    -- KEYBINDINGS (keybindings.conf / windowrules.conf)
    mainMod = "SUPER",
}
return env